{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cfs-todo",
  "version": "0.1.3",
  "identifier": "com.daniel.cfs-todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cfs-todo",
        "width": 800,
        "height": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3Rjc5MUVGODg2NjMxMkEKUldRcU1XYUk3NUgzNTJhdDF4SS9IZjlLMmpqVGZFZE9DSGcyR1FrWlE3eEl4aW1IRHFZZlhmakkK",
      "endpoints": [
        "https://github.com/danybeam/CFSTodo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}